#!/usr/bin/env sh
# Generated by the `night-light` module; edits will be replaced.
# Usage: smia-night-light [toggle|start|stop|status]   (default: toggle)
set -eu

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"

usage() {
    echo "Usage: smia-night-light [toggle|start|stop|status]" >&2
    exit 2
}

case "${1:-toggle}" in
    start)
        pgrep -x wlsunset >/dev/null 2>&1 && exit 0
        # exec keeps the process named `wlsunset` so pgrep/pkill callers work.
        exec wlsunset -l {{latitude}} -L {{longitude}} -t {{night-temp}} -T {{day-temp}}
        ;;
    stop)
        pkill -x wlsunset 2>/dev/null || true
        ;;
    toggle)
        if pgrep -x wlsunset >/dev/null 2>&1; then
            pkill -x wlsunset 2>/dev/null || true
        else
            # Subshell + exec detaches without setsid's fork ambiguity.
            ( trap '' HUP; exec "$0" start ) \
                >"$RUNTIME_DIR/smia-wlsunset.log" 2>&1 </dev/null &
            i=0
            while [ "$i" -lt 20 ]; do
                pgrep -x wlsunset >/dev/null 2>&1 && exit 0
                sleep 0.05
                i=$((i + 1))
            done
            echo "smia-night-light: wlsunset did not start; see $RUNTIME_DIR/smia-wlsunset.log" >&2
            exit 1
        fi
        ;;
    status)
        if pgrep -x wlsunset >/dev/null 2>&1; then
            echo on
        else
            echo off
            exit 1
        fi
        ;;
    -h|--help)
        echo "Usage: smia-night-light [toggle|start|stop|status]"
        ;;
    *)
        usage
        ;;
esac
