// Seeds default applications without overriding runtime choices. The MIME
// seed uses the lower-precedence XDG data path, while xdg-terminal-exec reads
// the user terminal list before its seed. Verify desktop-file IDs against the
// installed package set and override them per machine when needed.
module "default-apps" {
    description "Declarative seed for default applications: mimeapps.list and the fallback terminal list"

    types {
        refine "mime-type" base="string" format="mime-type"
        refine "desktop-file-id" base="string" format="desktop-file-id"
        alias "application-id" type="desktop-file-id"

        variant "mime-handler" discriminator="kind" {
            case "browser"
            case "file-manager"
            case "editor"
            case "application" {
                fields {
                    field "id" type="application-id" required=#true
                }
            }
        }
        record "mime-association" {
            fields {
                field "mime" type="mime-type" required=#true
                field "handler" type="mime-handler" required=#true
            }
        }
    }

    inputs {
        input "browser"      type="application-id" default="firefox.desktop"
        input "file-manager" type="application-id" default="org.gnome.Nautilus.desktop"
        input "editor"       type="application-id" default="Helix.desktop"
        input "terminal"     type="application-id" default="kitty.desktop"
        input "mime-associations" type="collection<mime-association>" {
            defaults {
                item "http" mime="x-scheme-handler/http" { handler kind="browser" }
                item "https" mime="x-scheme-handler/https" { handler kind="browser" }
                item "html" mime="text/html" { handler kind="browser" }
                item "xhtml" mime="application/xhtml+xml" { handler kind="browser" }
                item "directory" mime="inode/directory" { handler kind="file-manager" }
                item "text" mime="text/plain" { handler kind="editor" }
            }
        }
    }

    outputs {
        render "~/.local/share/applications/mimeapps.list" format="ini" {
            @comment "Generated by the `default-apps` module; edits will be replaced."
            @comment "Installed as a lower-precedence XDG default-applications seed."
            @comment "Runtime choices in ~/.config/mimeapps.list override these values."
            "Default Applications" {
                @for-each "association" in="mime-associations" {
                    @if "association.handler.kind" is="browser" {
                        (f)"{{association.mime}}" (ref)"browser"
                    }
                    @if "association.handler.kind" is="file-manager" {
                        (f)"{{association.mime}}" (ref)"file-manager"
                    }
                    @if "association.handler.kind" is="editor" {
                        (f)"{{association.mime}}" (ref)"editor"
                    }
                    @if "association.handler.kind" is="application" {
                        (f)"{{association.mime}}" (ref?)"association.handler.id"
                    }
                }
            }
        }
        render "xdg-terminals-default.list" format="line-list" {
            @comment "Generated by the `default-apps` module; edits will be replaced."
            @comment "Supplies the fallback terminal candidate."
            @comment "xdg-terminal-exec checks smia-menu's runtime choice first."
            @line (ref)"terminal"
        }
    }
}
