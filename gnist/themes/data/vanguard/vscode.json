{
  "name": "Studio",
  "type": "dark",
  "colors": {
    "foreground": "#F2F4F6",
    "descriptionForeground": "#98A1AB",
    "errorForeground": "#E5636C",
    "focusBorder": "#2DD4BF99",
    "selection.background": "#2DD4BF55",
    "textLink.foreground": "#2DD4BF",
    "textLink.activeForeground": "#86E0EC",

    "activityBar.background": "#0F1114",
    "activityBar.foreground": "#93C1FF",
    "activityBar.inactiveForeground": "#98A1AB",
    "activityBarBadge.background": "#2DD4BF",
    "activityBarBadge.foreground": "#0F1114",

    "sideBar.background": "#0F1114",
    "sideBar.foreground": "#F2F4F6",
    "sideBar.border": "#1C2026",
    "sideBarTitle.foreground": "#93C1FF",
    "sideBarSectionHeader.background": "#16191D",
    "sideBarSectionHeader.foreground": "#F2F4F6",

    "editor.background": "#0F1114",
    "editor.foreground": "#F2F4F6",
    "editorLineNumber.foreground": "#98A1AB",
    "editorLineNumber.activeForeground": "#2DD4BF",
    "editorCursor.foreground": "#2DD4BF",
    "editor.selectionBackground": "#2DD4BF44",
    "editor.inactiveSelectionBackground": "#3A414B55",
    "editor.lineHighlightBackground": "#16191D",
    "editorIndentGuide.background1": "#1C2026",
    "editorIndentGuide.activeBackground1": "#3A414B",
    "editorWhitespace.foreground": "#1C2026",

    "editorWidget.background": "#16191D",
    "editorWidget.foreground": "#F2F4F6",
    "editorWidget.border": "#1C2026",
    "editorSuggestWidget.background": "#16191D",
    "editorSuggestWidget.foreground": "#F2F4F6",
    "editorSuggestWidget.selectedBackground": "#232830",
    "editorSuggestWidget.highlightForeground": "#2DD4BF",

    "panel.background": "#0F1114",
    "panel.border": "#1C2026",
    "terminal.background": "#0F1114",
    "terminal.foreground": "#F2F4F6",
    "terminalCursor.foreground": "#2DD4BF",
    "terminal.ansiBlack": "#16191D",
    "terminal.ansiRed": "#E5636C",
    "terminal.ansiGreen": "#5BC98A",
    "terminal.ansiYellow": "#2DD4BF",
    "terminal.ansiBlue": "#2DD4BF",
    "terminal.ansiMagenta": "#B39DDB",
    "terminal.ansiCyan": "#4DD0E1",
    "terminal.ansiWhite": "#F2F4F6",
    "terminal.ansiBrightBlack": "#3A414B",
    "terminal.ansiBrightRed": "#F08A91",
    "terminal.ansiBrightGreen": "#7DDBA6",
    "terminal.ansiBrightYellow": "#93C1FF",
    "terminal.ansiBrightBlue": "#93C1FF",
    "terminal.ansiBrightMagenta": "#C9B6E8",
    "terminal.ansiBrightCyan": "#86E0EC",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "statusBar.background": "#16191D",
    "statusBar.foreground": "#F2F4F6",
    "statusBar.border": "#1C2026",
    "statusBarItem.remoteBackground": "#2DD4BF",
    "statusBarItem.remoteForeground": "#0F1114",
    "titleBar.activeBackground": "#0F1114",
    "titleBar.activeForeground": "#93C1FF",
    "titleBar.inactiveBackground": "#0F1114",
    "titleBar.inactiveForeground": "#98A1AB",

    "button.background": "#2DD4BF",
    "button.foreground": "#0F1114",
    "button.hoverBackground": "#93C1FF",
    "input.background": "#16191D",
    "input.foreground": "#F2F4F6",
    "input.border": "#1C2026",
    "dropdown.background": "#16191D",
    "dropdown.foreground": "#F2F4F6",
    "dropdown.border": "#1C2026",

    "list.activeSelectionBackground": "#2DD4BF33",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.hoverBackground": "#16191D",
    "list.highlightForeground": "#2DD4BF",
    "list.inactiveSelectionBackground": "#3A414B22"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#B39DDB", "fontStyle": "italic" } },
    { "scope": ["string", "markup.inline.raw.string"], "settings": { "foreground": "#5BC98A" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#2DD4BF" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#C9B6E8" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#93C1FF" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#93C1FF" } },
    { "scope": ["variable", "entity.name.variable", "support.variable"], "settings": { "foreground": "#F2F4F6" } },
    { "scope": ["entity.other.attribute-name", "variable.parameter"], "settings": { "foreground": "#FFFFFF" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#B39DDB" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#93C1FF", "fontStyle": "bold" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#2DD4BF" } },
    { "scope": ["markup.deleted", "invalid"], "settings": { "foreground": "#E5636C" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#5BC98A" } }
  ]
}
