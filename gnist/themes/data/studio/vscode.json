{
  "name": "Studio",
  "type": "dark",
  "colors": {
    "foreground": "#EAE7E1",
    "descriptionForeground": "#A5ACB5",
    "errorForeground": "#EB9DA2",
    "focusBorder": "#B9C2CC99",
    "selection.background": "#B9C2CC33",
    "textLink.foreground": "#B9C2CC",
    "textLink.activeForeground": "#9DD9EA",

    "activityBar.background": "#23262B",
    "activityBar.foreground": "#D5DBE2",
    "activityBar.inactiveForeground": "#A5ACB5",
    "activityBarBadge.background": "#B9C2CC",
    "activityBarBadge.foreground": "#23262B",

    "sideBar.background": "#23262B",
    "sideBar.foreground": "#EAE7E1",
    "sideBar.border": "#31363D",
    "sideBarTitle.foreground": "#D5DBE2",
    "sideBarSectionHeader.background": "#292D33",
    "sideBarSectionHeader.foreground": "#EAE7E1",

    "editor.background": "#23262B",
    "editor.foreground": "#EAE7E1",
    "editorLineNumber.foreground": "#A5ACB5",
    "editorLineNumber.activeForeground": "#B9C2CC",
    "editorCursor.foreground": "#B9C2CC",
    "editor.selectionBackground": "#B9C2CC33",
    "editor.inactiveSelectionBackground": "#383D4455",
    "editor.lineHighlightBackground": "#292D33",
    "editorIndentGuide.background1": "#31363D",
    "editorIndentGuide.activeBackground1": "#383D44",
    "editorWhitespace.foreground": "#31363D",

    "editorWidget.background": "#292D33",
    "editorWidget.foreground": "#EAE7E1",
    "editorWidget.border": "#31363D",
    "editorSuggestWidget.background": "#292D33",
    "editorSuggestWidget.foreground": "#EAE7E1",
    "editorSuggestWidget.selectedBackground": "#383D44",
    "editorSuggestWidget.highlightForeground": "#B9C2CC",

    "panel.background": "#23262B",
    "panel.border": "#31363D",
    "terminal.background": "#23262B",
    "terminal.foreground": "#EAE7E1",
    "terminalCursor.foreground": "#B9C2CC",
    "terminal.ansiBlack": "#292D33",
    "terminal.ansiRed": "#EB9DA2",
    "terminal.ansiGreen": "#8FC5A1",
    "terminal.ansiYellow": "#D3AF80",
    "terminal.ansiBlue": "#96B9E6",
    "terminal.ansiMagenta": "#B6AEE3",
    "terminal.ansiCyan": "#7DC2D6",
    "terminal.ansiWhite": "#EAE7E1",
    "terminal.ansiBrightBlack": "#828B98",
    "terminal.ansiBrightRed": "#FEB8BE",
    "terminal.ansiBrightGreen": "#ACDBBC",
    "terminal.ansiBrightYellow": "#E6C99F",
    "terminal.ansiBrightBlue": "#B3D0F9",
    "terminal.ansiBrightMagenta": "#CFC6F5",
    "terminal.ansiBrightCyan": "#9DD9EA",
    "terminal.ansiBrightWhite": "#F7F4EE",

    "statusBar.background": "#292D33",
    "statusBar.foreground": "#EAE7E1",
    "statusBar.border": "#31363D",
    "statusBarItem.remoteBackground": "#B9C2CC",
    "statusBarItem.remoteForeground": "#23262B",
    "titleBar.activeBackground": "#23262B",
    "titleBar.activeForeground": "#D5DBE2",
    "titleBar.inactiveBackground": "#23262B",
    "titleBar.inactiveForeground": "#A5ACB5",

    "button.background": "#B9C2CC",
    "button.foreground": "#23262B",
    "button.hoverBackground": "#D5DBE2",
    "input.background": "#292D33",
    "input.foreground": "#EAE7E1",
    "input.border": "#31363D",
    "dropdown.background": "#292D33",
    "dropdown.foreground": "#EAE7E1",
    "dropdown.border": "#31363D",

    "list.activeSelectionBackground": "#B9C2CC33",
    "list.activeSelectionForeground": "#F7F4EE",
    "list.hoverBackground": "#292D33",
    "list.highlightForeground": "#B9C2CC",
    "list.inactiveSelectionBackground": "#383D4422"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#B6AEE3", "fontStyle": "italic" } },
    { "scope": ["string", "markup.inline.raw.string"], "settings": { "foreground": "#8FC5A1" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#D3AF80" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#CFC6F5" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#B3D0F9" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#B3D0F9" } },
    { "scope": ["variable", "entity.name.variable", "support.variable"], "settings": { "foreground": "#EAE7E1" } },
    { "scope": ["entity.other.attribute-name", "variable.parameter"], "settings": { "foreground": "#F7F4EE" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#B6AEE3" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#D5DBE2", "fontStyle": "bold" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#D3AF80" } },
    { "scope": ["markup.deleted", "invalid"], "settings": { "foreground": "#EB9DA2" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#8FC5A1" } }
  ]
}
