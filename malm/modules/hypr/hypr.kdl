// Provides Hyprland for the "compositor" slot.
module "hypr" {
    description "Hyprland compositor"
    slot "compositor"

    requires {
        command "Hyprland"
        command "hyprctl"
        // The file-manager binding in the generated config invokes nautilus.
        command "nautilus"
    }

    types {
        enum "bind-command-source" {
            values "terminal" "file-manager" "launcher" "menu" "lock" "wallpaper"
        }
        enum "bind-argument-action" { values "toggle" }
        enum "bind-direction" { values "left" "right" "up" "down" }
        enum "bind-mode" { values "maximized" }

        variant "bind-argument" discriminator="kind" {
            case "none"
            case "literal" {
                fields {
                    field "value" type="string" required=#true
                }
            }
            case "command" {
                fields {
                    field "source" type="bind-command-source" required=#true
                }
            }
            case "record" {
                fields {
                    field "action" type="bind-argument-action?"
                    field "direction" type="bind-direction?"
                    field "mode" type="bind-mode?"
                    field "workspace" type="string?"
                }
            }
        }

        refine "opacity" base="float" min=0.0 max=1.0
        refine "non-negative-int" base="int" min=0
        refine "ratio" base="float" min=0.0 max=1.0

        record "bind-options" {
            fields {
                field "mouse" type="bool?"
                field "repeating" type="bool?"
                field "locked" type="bool?"
            }
        }
        record "binding" {
            fields {
                field "chord" type="string" required=#true
                field "mod" type="bool" required=#true default=#true
                field "action" type="string" required=#true
                field "argument" type="bind-argument" required=#true
                field "options" type="bind-options"
                field "label" type="string" required=#true
            }
        }
    }

    inputs {
        input "mod-key"       type="string" default="SUPER"
        input "terminal-cmd"  type="string" default="xdg-terminal-exec"
        input "launcher-cmd"  type="string" default="xdg-launcher-exec"
        input "menu-cmd"      type="string" default="smia-menu"
        input "lock-cmd"      type="string" default="hyprlock"
        input "wallpaper-cmd" type="string" default="gnist wallpaper"
        input "file-manager"  type="string" default="nautilus"

        input "xkb-layout" type="string" default="no"
        input "xkb-variant" type="string" default="nodeadkeys"
        input "repeat-rate" type="non-negative-int" default=25
        input "repeat-delay" type="non-negative-int" default=250
        input "numlock" type="bool" default=#false
        input "touchpad-tap" type="bool" default=#true
        input "touchpad-natural-scroll" type="bool" default=#true
        input "touchpad-disable-while-typing" type="bool" default=#true
        input "gaps-in" type="non-negative-int" default=5
        input "gaps-out" type="non-negative-int" default=12
        input "border-size" type="non-negative-int" default=2
        input "cursor-size" type="non-negative-int" default=24
        input "rounding" type="non-negative-int" default=0
        input "active-opacity" type="opacity" default=1.0
        input "inactive-opacity" type="opacity" default=1.0
        input "shadow-enabled" type="bool" default=#true
        input "shadow-range" type="non-negative-int" default=4
        input "shadow-render-power" type="non-negative-int" default=3
        input "blur" type="bool" default=#true
        input "blur-size" type="non-negative-int" default=3
        input "blur-passes" type="non-negative-int" default=1
        input "blur-vibrancy" type="ratio" default=0.1696
        input "animations" type="bool" default=#true

        // Named nested authoring records retain the stable Lua data shape.
        input "binds" type="collection<binding>" {
            defaults {
                item "terminal" chord="Return" action="exec_cmd" label="Open terminal" {
                    argument kind="command" source="terminal"
                }
                item "close-window" chord="Q" action="window.close" label="Close window" {
                    argument kind="none"
                }
                item "power-menu" chord="M" action="exec_cmd" label="Power menu" {
                    argument kind="literal" value="command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit"
                }
                item "file-manager" chord="E" action="exec_cmd" label="Open file manager" {
                    argument kind="command" source="file-manager"
                }
                item "toggle-floating" chord="V" action="window.float" label="Toggle floating" {
                    argument kind="record" action="toggle"
                }
                item "launcher" chord="A" action="exec_cmd" label="Open launcher" {
                    argument kind="command" source="launcher"
                }
                item "pseudotile" chord="P" action="window.pseudo" label="Toggle pseudotile" {
                    argument kind="none"
                }
                item "wallpaper" chord="W" action="exec_cmd" label="Next wallpaper" {
                    argument kind="command" source="wallpaper"
                }
                item "menu" chord="Space" action="exec_cmd" label="Open menu" {
                    argument kind="command" source="menu"
                }
                item "lock" chord="Escape" action="exec_cmd" label="Lock screen" {
                    argument kind="command" source="lock"
                }
                item "screenshot-region" chord="Print" mod=#false action="exec_cmd" label="Screenshot region" {
                    argument kind="literal" value="gnist-screenshot region"
                }
                item "screenshot-screen" chord="CTRL + Print" mod=#false action="exec_cmd" label="Screenshot screen" {
                    argument kind="literal" value="gnist-screenshot screen"
                }
                item "screenshot-window" chord="ALT + Print" mod=#false action="exec_cmd" label="Screenshot window" {
                    argument kind="literal" value="gnist-screenshot window"
                }
                item "record-screen" chord="ALT + R" action="exec_cmd" label="Record screen" {
                    argument kind="literal" value="smia-record toggle screen"
                }
                item "record-region" chord="ALT + SHIFT + R" action="exec_cmd" label="Record region" {
                    argument kind="literal" value="smia-record toggle region"
                }
                item "toggle-split" chord="SHIFT + J" action="layout" label="Toggle split" {
                    argument kind="literal" value="togglesplit"
                }
                item "maximize" chord="F" action="window.fullscreen" label="Toggle maximize" {
                    argument kind="record" mode="maximized" action="toggle"
                }
                item "focus-left" chord="h" action="focus" label="Focus left" {
                    argument kind="record" direction="left"
                }
                item "focus-right" chord="l" action="focus" label="Focus right" {
                    argument kind="record" direction="right"
                }
                item "focus-up" chord="k" action="focus" label="Focus up" {
                    argument kind="record" direction="up"
                }
                item "focus-down" chord="j" action="focus" label="Focus down" {
                    argument kind="record" direction="down"
                }
                item "scratchpad" chord="S" action="workspace.toggle_special" label="Toggle scratchpad" {
                    argument kind="literal" value="magic"
                }
                item "scratchpad-move" chord="SHIFT + S" action="window.move" label="Move to scratchpad" {
                    argument kind="record" workspace="special:magic"
                }
                item "workspace-next" chord="mouse_down" action="focus" label="Next workspace" {
                    argument kind="record" workspace="e+1"
                }
                item "workspace-prev" chord="mouse_up" action="focus" label="Previous workspace" {
                    argument kind="record" workspace="e-1"
                }
                item "drag-window" chord="mouse:272" action="window.drag" label="Drag window" {
                    argument kind="none"; options mouse=#true
                }
                item "resize-window" chord="mouse:273" action="window.resize" label="Resize window" {
                    argument kind="none"; options mouse=#true
                }
                item "volume-raise" chord="XF86AudioRaiseVolume" mod=#false action="exec_cmd" label="Raise volume" {
                    argument kind="literal" value="swayosd-client --output-volume raise"; options repeating=#true locked=#true
                }
                item "volume-lower" chord="XF86AudioLowerVolume" mod=#false action="exec_cmd" label="Lower volume" {
                    argument kind="literal" value="swayosd-client --output-volume lower"; options repeating=#true locked=#true
                }
                item "volume-mute" chord="XF86AudioMute" mod=#false action="exec_cmd" label="Mute audio" {
                    argument kind="literal" value="swayosd-client --output-volume mute-toggle"; options repeating=#true locked=#true
                }
                item "mic-mute" chord="XF86AudioMicMute" mod=#false action="exec_cmd" label="Mute microphone" {
                    argument kind="literal" value="swayosd-client --input-volume mute-toggle"; options repeating=#true locked=#true
                }
                item "brightness-up" chord="XF86MonBrightnessUp" mod=#false action="exec_cmd" label="Raise brightness" {
                    argument kind="literal" value="swayosd-client --brightness raise"; options repeating=#true locked=#true
                }
                item "brightness-down" chord="XF86MonBrightnessDown" mod=#false action="exec_cmd" label="Lower brightness" {
                    argument kind="literal" value="swayosd-client --brightness lower"; options repeating=#true locked=#true
                }
                item "media-next" chord="XF86AudioNext" mod=#false action="exec_cmd" label="Next track" {
                    argument kind="literal" value="swayosd-client --playerctl next"; options locked=#true
                }
                item "media-pause" chord="XF86AudioPause" mod=#false action="exec_cmd" label="Play/pause" {
                    argument kind="literal" value="swayosd-client --playerctl play-pause"; options locked=#true
                }
                item "media-play" chord="XF86AudioPlay" mod=#false action="exec_cmd" label="Play/pause" {
                    argument kind="literal" value="swayosd-client --playerctl play-pause"; options locked=#true
                }
                item "media-prev" chord="XF86AudioPrev" mod=#false action="exec_cmd" label="Previous track" {
                    argument kind="literal" value="swayosd-client --playerctl prev"; options locked=#true
                }
            }
        }
    }

    outputs {
        file "./gnist/hyprland.lua.tpl" to="gnist/themes/templates/hyprland.lua.tpl"
        render "gnist/bindings.d/hyprland.kdl" format="text" {
            @include-file "./gnist/hyprland.kdl"
        }

        // Idiomatic Hyprland Lua: the template carries the static structure and
        // scalar inputs, and each typed bind becomes one `hl.bind` call, so the
        // config and `binds.list` below cannot drift apart.
        render "hypr/hyprland.lua" format="lua" {
            @include-file "./hyprland.lua.tpl" interpolate=#true

            @for-each "bind" in="binds" {
                @line ""
                @line (f)"-- {{bind.label}}"
                @line "hl.bind("
                @if "bind.mod" is=#true {
                    @line (f)"    \"{{mod-key}} + {{bind.chord}}\","
                }
                @else {
                    @line (f)"    \"{{bind.chord}}\","
                }
                @if "bind.argument.kind" is="none" {
                    @line (f)"    hl.dsp.{{bind.action}}(),"
                }
                @if "bind.argument.kind" is="literal" {
                    @if-present "bind.argument.value" {
                        @line (f)"    hl.dsp.{{bind.action}}({{bind.argument.value:lua}}),"
                    }
                }
                @if "bind.argument.kind" is="command" {
                    @if "bind.argument.source" is="terminal" {
                        @line (f)"    hl.dsp.{{bind.action}}({{terminal-cmd:lua}}),"
                    }
                    @if "bind.argument.source" is="file-manager" {
                        @line (f)"    hl.dsp.{{bind.action}}({{file-manager:lua}}),"
                    }
                    @if "bind.argument.source" is="launcher" {
                        @line (f)"    hl.dsp.{{bind.action}}({{launcher-cmd:lua}}),"
                    }
                    @if "bind.argument.source" is="menu" {
                        @line (f)"    hl.dsp.{{bind.action}}({{menu-cmd:lua}}),"
                    }
                    @if "bind.argument.source" is="lock" {
                        @line (f)"    hl.dsp.{{bind.action}}({{lock-cmd:lua}}),"
                    }
                    @if "bind.argument.source" is="wallpaper" {
                        @line (f)"    hl.dsp.{{bind.action}}({{wallpaper-cmd:lua}}),"
                    }
                }
                @if "bind.argument.kind" is="record" {
                    @line (f)"    hl.dsp.{{bind.action}}({"
                    @if-present "bind.argument.action" {
                        @line (f)"        action = {{bind.argument.action:lua}},"
                    }
                    @if-present "bind.argument.direction" {
                        @line (f)"        direction = {{bind.argument.direction:lua}},"
                    }
                    @if-present "bind.argument.mode" {
                        @line (f)"        mode = {{bind.argument.mode:lua}},"
                    }
                    @if-present "bind.argument.workspace" {
                        @line (f)"        workspace = {{bind.argument.workspace:lua}},"
                    }
                    @line "    }),"
                }
                // Every bind passes options: all fields are optional, so an empty
                // table is exactly the no-options call.
                @if-present "bind.options" {
                    @line "    {"
                    @if-present "bind.options.mouse" {
                        @line (f)"        mouse = {{bind.options.mouse:lua}},"
                    }
                    @if-present "bind.options.repeating" {
                        @line (f)"        repeating = {{bind.options.repeating:lua}},"
                    }
                    @if-present "bind.options.locked" {
                        @line (f)"        locked = {{bind.options.locked:lua}},"
                    }
                    @line "    }"
                }
                @else {
                    @line "    {}"
                }
                @line ")"
            }
        }

        // Keybind cheatsheet for `smia menu` (menu.d/keys.sh): one
        // `chord|label` row per bind, workspace rows included.
        render "hypr/binds.list" format="text" {
            @for-each "bind" in="binds" {
                @if "bind.mod" is=#true {
                    @line (f)"{{mod-key}} + {{bind.chord}}|{{bind.label}}"
                }
                @else {
                    @line (f)"{{bind.chord}}|{{bind.label}}"
                }
            }
            @for-range "workspace" from=1 through=9 {
                @line (f)"{{mod-key}} + {{workspace}}|Workspace {{workspace}}"
                @line (f)"{{mod-key}} + SHIFT + {{workspace}}|Move window to workspace {{workspace}}"
            }
            @line (f)"{{mod-key}} + 0|Workspace 10"
            @line (f)"{{mod-key}} + SHIFT + 0|Move window to workspace 10"
        }
    }
}
