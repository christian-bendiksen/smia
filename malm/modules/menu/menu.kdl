// Owns the system-menu host, its built-in executable plugins, and the toggle
// commands consumed by the Toggles plugin and the Waybar indicators. Profiles
// patch the keyed items collection to enable or disable managed entries.
module "menu" {
    description "Modular Walker system menu, toggle commands, and profile-selectable built-in entries"

    requires {
        command "bash"
        command "gio"
        command "gnist"
        command "pgrep"
        command "pkill"
        command "ps"
        command "setsid"
        command "sort"
        command "systemctl"
        command "walker"
    }

    inputs {
        input "items" type="collection<string>" {
            defaults {
                item "toggles" "toggles"
                item "keys" "keys"
                item "network" "network"
                item "profiles" "profiles"
                item "themes" "themes"
                item "wallpaper" "wallpaper"
                item "defaults" "defaults"
                item "services" "services"
                item "power" "power"
            }
        }
    }

    outputs {
        file "./bin/smia-menu" to="~/.local/bin/smia-menu" executable=#true
        file "./bin/smia-idle" to="~/.local/bin/smia-idle" executable=#true
        file "./bin/smia-dnd" to="~/.local/bin/smia-dnd" executable=#true
        file "./menu.d/toggles.sh" to="~/.local/share/smia/menu.d/toggles.sh" executable=#true
        file "./menu.d/keys.sh" to="~/.local/share/smia/menu.d/keys.sh" executable=#true
        file "./menu.d/network.sh" to="~/.local/share/smia/menu.d/network.sh" executable=#true
        file "./menu.d/profiles.sh" to="~/.local/share/smia/menu.d/profiles.sh" executable=#true
        file "./menu.d/themes.sh" to="~/.local/share/smia/menu.d/themes.sh" executable=#true
        file "./menu.d/wallpaper.sh" to="~/.local/share/smia/menu.d/wallpaper.sh" executable=#true
        file "./menu.d/defaults.sh" to="~/.local/share/smia/menu.d/defaults.sh" executable=#true
        file "./menu.d/services.sh" to="~/.local/share/smia/menu.d/services.sh" executable=#true
        file "./menu.d/power.sh" to="~/.local/share/smia/menu.d/power.sh" executable=#true
        render "smia/menu-items" format="line-list" {
            @comment "Generated by the `menu` module; profiles patch the keyed items collection."
            @for-each "item" in="items" {
                @line (ref)"item"
            }
        }
    }
}
