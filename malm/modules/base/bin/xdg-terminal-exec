#!/usr/bin/env sh

set -eu

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
# Keep this aligned with defaults.sh's DESKTOP_DIRS so every selectable
# desktop entry can be resolved, including Flatpak exports.
APP_DIRS="$HOME/.local/share/applications:$HOME/.local/share/flatpak/exports/share/applications:/var/lib/flatpak/exports/share/applications:/usr/local/share/applications:/usr/share/applications"

find_desktop() {
    entry="$1"
    case "$entry" in /*)
        [ -r "$entry" ] && { printf '%s\n' "$entry"; return 0; }
        return 1
    esac
    OLD_IFS="$IFS"
    IFS=:
    for d in $APP_DIRS; do
        if [ -r "$d/$entry" ]; then
            IFS="$OLD_IFS"
            printf '%s\n' "$d/$entry"
            return 0
        fi
    done
    IFS="$OLD_IFS"
    return 1
}

# Print the full Exec command line with field codes stripped, so wrapper
# entries such as `flatpak run --command=foot ...` keep their arguments.
exec_command() {
    awk '
        /^\[/ { in_de = ($0 == "[Desktop Entry]") }
        in_de && /^Exec=/ {
            sub(/^Exec=/, "")
            gsub(/%[fFuUdDnNickvm]/, "")
            gsub(/[ \t]+/, " ")
            sub(/^ /, ""); sub(/ $/, "")
            print
            exit
        }
    ' "$1"
}

# xdg-terminals spec: X-ExecArg/ExecArg names the flag placed before the
# command (default -e); an explicitly empty value means positional.
exec_arg() {
    arg="$(awk '
        /^\[/ { in_de = ($0 == "[Desktop Entry]") }
        in_de && /^(X-)?ExecArg=/ {
            sub(/^(X-)?ExecArg=/, "")
            print "found=" $0
            exit
        }
    ' "$1")"
    case "$arg" in
        found=*) printf '%s\n' "${arg#found=}" ;;
        *) printf -- '-e\n' ;;
    esac
}

# launch COMMAND EXEC_ARG [ARGS...]: word-splits COMMAND, appends EXEC_ARG
# and ARGS when a command was requested. Returns 1 instead of exec'ing when
# the binary is missing so callers can fall through to the next candidate.
launch() {
    launch_cmd="$1"
    launch_arg="$2"
    shift 2
    set -f
    if [ "$#" -gt 0 ] && [ -n "$launch_arg" ]; then
        # shellcheck disable=SC2086
        set +f -- $launch_cmd "$launch_arg" "$@"
    else
        # shellcheck disable=SC2086
        set +f -- $launch_cmd "$@"
    fi
    command -v "$1" >/dev/null 2>&1 || return 1
    exec "$@"
}

# Prefer the smia-menu runtime choice, then the default-apps seed.
for LIST in "$CONFIG_DIR/xdg-terminals.list" "$CONFIG_DIR/xdg-terminals-default.list"; do
    [ -r "$LIST" ] || continue
    while IFS= read -r entry || [ -n "$entry" ]; do
        case "$entry" in ''|\#*) continue ;; esac
        desktop="$(find_desktop "$entry")" || continue
        cmd="$(exec_command "$desktop")"
        [ -z "$cmd" ] && continue
        launch "$cmd" "$(exec_arg "$desktop")" "$@" || continue
    done < "$LIST"
done

if [ -n "${TERMINAL:-}" ]; then
    launch "$TERMINAL" "-e" "$@" || :
fi

for term in alacritty kitty foot ghostty wezterm xterm; do
    case "$term" in
        foot) launch "$term" "" "$@" || : ;;
        wezterm) launch "$term start" "--" "$@" || : ;;
        *) launch "$term" "-e" "$@" || : ;;
    esac
done

echo "xdg-terminal-exec: no terminal emulator found" >&2
exit 1
