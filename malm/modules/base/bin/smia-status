#!/usr/bin/env bash

set -euo pipefail

SMIA_DESKTOP_NAMESPACE="${SMIA_DESKTOP_NAMESPACE:-default}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
SMIA_CONFIG_DIR="$XDG_CONFIG_HOME/smia"

failed=0

usage() {
    cat <<'EOF'
Usage: smia-status

Read-only health report: deployment drift, session services, profile,
theme, and module requirements. Exits 1 when any check fails.
EOF
}

case "${1:-}" in
    "") ;;
    -h|--help)
        (($# == 1)) || { usage >&2; exit 2; }
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

ok() {
    printf 'ok:   %s\n' "$1"
}

bad() {
    printf 'FAIL: %s\n' "$1"
    failed=1
}

section() {
    printf '\n== %s ==\n' "$1"
}

# Parse the small JSON response with Bash after validating its raw byte stream.
json_skip_space() {
    local char
    while ((_json_pos < _json_len)); do
        char="${_json_text:_json_pos:1}"
        case "$char" in
            ' '|$'\t'|$'\r'|$'\n') _json_pos=$((_json_pos + 1)) ;;
            *) return 0 ;;
        esac
    done
}

json_parse_string() {
    local char escape hex
    [[ "${_json_text:_json_pos:1}" == '"' ]] || return 1
    _json_pos=$((_json_pos + 1))
    _json_string=""
    while ((_json_pos < _json_len)); do
        char="${_json_text:_json_pos:1}"
        _json_pos=$((_json_pos + 1))
        case "$char" in
            '"') return 0 ;;
            \\)
                ((_json_pos < _json_len)) || return 1
                escape="${_json_text:_json_pos:1}"
                _json_pos=$((_json_pos + 1))
                case "$escape" in
                    '"'|\\|/|b|f|n|r|t)
                        _json_string+="\\$escape"
                        ;;
                    u)
                        ((_json_pos + 4 <= _json_len)) || return 1
                        hex="${_json_text:_json_pos:4}"
                        [[ "$hex" =~ ^[[:xdigit:]]{4}$ ]] || return 1
                        _json_string+="\\u$hex"
                        _json_pos=$((_json_pos + 4))
                        ;;
                    *) return 1 ;;
                esac
                ;;
            *)
                [[ "$char" != [[:cntrl:]] ]] || return 1
                _json_string+="$char"
                ;;
        esac
    done
    return 1
}

json_string_is_ascii() {
    local raw="$1" expected="$2"
    local raw_pos=0 expected_pos=0 char escape hex decoded expected_char
    local raw_len=${#raw} expected_len=${#expected} expected_code code

    while ((raw_pos < raw_len)); do
        ((expected_pos < expected_len)) || return 1
        char="${raw:raw_pos:1}"
        raw_pos=$((raw_pos + 1))
        expected_char="${expected:expected_pos:1}"
        if [[ "$char" == \\ ]]; then
            ((raw_pos < raw_len)) || return 1
            escape="${raw:raw_pos:1}"
            raw_pos=$((raw_pos + 1))
            case "$escape" in
                '"'|\\|/) decoded="$escape" ;;
                u)
                    ((raw_pos + 4 <= raw_len)) || return 1
                    hex="${raw:raw_pos:4}"
                    [[ "$hex" =~ ^[[:xdigit:]]{4}$ ]] || return 1
                    raw_pos=$((raw_pos + 4))
                    code=$((16#$hex))
                    printf -v expected_code '%d' "'$expected_char"
                    ((code == expected_code)) || return 1
                    expected_pos=$((expected_pos + 1))
                    continue
                    ;;
                *) return 1 ;;
            esac
        else
            decoded="$char"
        fi
        [[ "$decoded" == "$expected_char" ]] || return 1
        expected_pos=$((expected_pos + 1))
    done
    ((expected_pos == expected_len))
}

json_parse_number() {
    local remainder="${_json_text:_json_pos}"
    local number_re='^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?'
    [[ "$remainder" =~ $number_re ]] || return 1
    _json_pos=$((_json_pos + ${#BASH_REMATCH[0]}))
}

json_parse_array() {
    local depth="$1" char
    [[ "${_json_text:_json_pos:1}" == '[' ]] || return 1
    _json_pos=$((_json_pos + 1))
    json_skip_space
    if [[ "${_json_text:_json_pos:1}" == ']' ]]; then
        _json_pos=$((_json_pos + 1))
        return 0
    fi
    while true; do
        json_parse_value "$((depth + 1))" || return 1
        json_skip_space
        char="${_json_text:_json_pos:1}"
        case "$char" in
            ',') _json_pos=$((_json_pos + 1)) ;;
            ']') _json_pos=$((_json_pos + 1)); return 0 ;;
            *) return 1 ;;
        esac
    done
}

json_parse_object() {
    local depth="$1" char key
    [[ "${_json_text:_json_pos:1}" == '{' ]] || return 1
    _json_pos=$((_json_pos + 1))
    json_skip_space
    if [[ "${_json_text:_json_pos:1}" == '}' ]]; then
        _json_pos=$((_json_pos + 1))
        return 0
    fi
    while true; do
        json_skip_space
        json_parse_string || return 1
        key="$_json_string"
        json_skip_space
        [[ "${_json_text:_json_pos:1}" == ':' ]] || return 1
        _json_pos=$((_json_pos + 1))
        json_skip_space
        if ((depth == 0)) && json_string_is_ascii "$key" outcome; then
            ((_json_status_seen == 0)) || return 1
            json_parse_string || return 1
            _json_status_raw="$_json_string"
            _json_status_seen=1
        else
            json_parse_value "$((depth + 1))" || return 1
        fi
        json_skip_space
        char="${_json_text:_json_pos:1}"
        case "$char" in
            ',') _json_pos=$((_json_pos + 1)) ;;
            '}') _json_pos=$((_json_pos + 1)); return 0 ;;
            *) return 1 ;;
        esac
    done
}

json_parse_value() {
    local depth="$1" char
    ((depth <= 64)) || return 1
    json_skip_space
    ((_json_pos < _json_len)) || return 1
    char="${_json_text:_json_pos:1}"
    case "$char" in
        '{') json_parse_object "$depth" ;;
        '[') json_parse_array "$depth" ;;
        '"') json_parse_string ;;
        t)
            [[ "${_json_text:_json_pos:4}" == true ]] || return 1
            _json_pos=$((_json_pos + 4))
            ;;
        f)
            [[ "${_json_text:_json_pos:5}" == false ]] || return 1
            _json_pos=$((_json_pos + 5))
            ;;
        n)
            [[ "${_json_text:_json_pos:4}" == null ]] || return 1
            _json_pos=$((_json_pos + 4))
            ;;
        -|[0-9]) json_parse_number ;;
        *) return 1 ;;
    esac
}

json_status_is_enabled_exact() {
    _json_text="$1"
    _json_pos=0
    _json_len=${#_json_text}
    _json_string=""
    _json_status_raw=""
    _json_status_seen=0

    json_skip_space
    json_parse_object 0 || return 1
    json_skip_space
    ((_json_pos == _json_len && _json_status_seen == 1)) || return 1
    json_string_is_ascii "$_json_status_raw" enabled_exact
}

json_status_file_is_enabled_exact() {
    local file="$1" status_json=""
    local LC_ALL=C

    iconv -f UTF-8 -t UTF-8 <"$file" >/dev/null 2>&1 || return 1
    if IFS= read -r -d '' status_json <"$file"; then
        return 1
    fi
    json_status_is_enabled_exact "$status_json"
}

status_json_file="$(mktemp "${TMPDIR:-/tmp}/smia-status.XXXXXX")"
cleanup_status_json_file() {
    rm -f -- "$status_json_file" || true
}
trap cleanup_status_json_file EXIT

section "Deployment drift"
if ! command -v malm >/dev/null 2>&1; then
    bad "malm not found in PATH"
else
    if malm namespace status --namespace "$SMIA_DESKTOP_NAMESPACE" \
        --format json >"$status_json_file" \
        && json_status_file_is_enabled_exact "$status_json_file"; then
        ok "namespace $SMIA_DESKTOP_NAMESPACE matches the committed configuration"
    else
        bad "namespace $SMIA_DESKTOP_NAMESPACE is not enabled and exact"
    fi
fi

section "Session services"
collect_manifest() {
    local file
    for file in "$SMIA_CONFIG_DIR/session.services" "$SMIA_CONFIG_DIR"/session.d/*; do
        [[ -r "$file" ]] && cat "$file"
    done
}
declare -A seen_processes=()
service_count=0
while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    read -r directive rest <<<"$line"
    read -r proc _ <<<"$rest"
    [[ -n "$proc" ]] || continue
    [[ -n "${seen_processes[$proc]+set}" ]] && continue
    seen_processes["$proc"]=1
    case "$directive" in
        run|restart)
            service_count=$((service_count + 1))
            if pgrep -x "$proc" >/dev/null 2>&1; then
                ok "service $proc is running"
            else
                bad "service $proc is not running"
            fi
            ;;
        stop)
            if pgrep -x "$proc" >/dev/null 2>&1; then
                bad "service $proc should be stopped but is running"
            fi
            ;;
        prepare)
            printf 'info: %s is start-once (not checked)\n' "$proc"
            ;;
    esac
done < <(collect_manifest)
((service_count > 0)) || bad "no session services configured"

section "Profile"
running_compositor_provider() {
    local desktop
    for desktop in "${XDG_CURRENT_DESKTOP:-}" "${XDG_SESSION_DESKTOP:-}"; do
        case "${desktop,,}" in
            *mango*)     printf 'mango\n'; return 0 ;;
            *niri*)      printf 'niri\n'; return 0 ;;
            *hyprland*)  printf 'hypr\n'; return 0 ;;
        esac
    done

    if pgrep -x mango >/dev/null 2>&1; then printf 'mango\n'
    elif pgrep -x niri >/dev/null 2>&1; then printf 'niri\n'
    elif pgrep -x Hyprland >/dev/null 2>&1; then printf 'hypr\n'
    else return 1
    fi
}
profile_provider() {
    case "$1" in
        mango*)    printf 'mango\n' ;;
        niri*)     printf 'niri\n' ;;
        hyprland*) printf 'hypr\n' ;;
        *) return 1 ;;
    esac
}
profile=""
if [[ -r "$SMIA_CONFIG_DIR/profile" ]]; then
    IFS= read -r profile < "$SMIA_CONFIG_DIR/profile" || true
fi
if [[ -z "$profile" ]]; then
    bad "no applied profile recorded in $SMIA_CONFIG_DIR/profile"
elif provider="$(running_compositor_provider)"; then
    if [[ "$(profile_provider "$profile" || true)" == "$provider" ]]; then
        ok "profile $profile matches the running compositor"
    else
        bad "profile $profile does not match the running compositor ($provider)"
    fi
else
    printf 'info: profile %s (no compositor running to compare)\n' "$profile"
fi

section "Theme"
if ! command -v gnist >/dev/null 2>&1; then
    bad "gnist not found in PATH"
elif ! gnist current >/dev/null 2>&1; then
    bad "gnist has no current theme (run gnist init)"
elif [[ ! -e "$XDG_CONFIG_HOME/gnist/themes/current" ]]; then
    bad "gnist theme files are missing at gnist/themes/current"
else
    ok "theme $(gnist current 2>/dev/null || echo unknown) is active"
fi

section "Module requirements"
requirement_count=0
for manifest in "$SMIA_CONFIG_DIR/requirements.commands"; do
    [[ -r "$manifest" ]] || continue
    while IFS= read -r command || [[ -n "$command" ]]; do
        [[ "$command" =~ ^[[:space:]]*(#|$) ]] && continue
        requirement_count=$((requirement_count + 1))
        if [[ "$command" == /* ]]; then
            [[ -x "$command" ]] && ok "required executable $command" \
                || bad "required executable is missing: $command"
        elif command -v "$command" >/dev/null 2>&1; then
            ok "required command $command"
        else
            bad "required command is missing: $command"
        fi
    done < "$manifest"
done
((requirement_count > 0)) || bad "no deployed requirement manifest was found"

exit "$failed"
