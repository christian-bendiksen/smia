layout {
    gaps 12

    shadow {
        off
    }
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

animations {
    window-open {
        duration-ms 220
        curve "cubic-bezier" 0.16 1.0 0.3 1.0
    }
    window-close {
        duration-ms 180
        curve "ease-out-quad"
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}
